APP_ENV=development
DATABASE_URL=postgresql+psycopg://smart_garden:smart_garden_local_only@localhost:5432/smart_garden
# Development/test may use this local placeholder. Staging/production must supply
# an explicit, randomly generated secret of at least 32 characters.
SECRET_KEY=CHANGE_ME_LOCAL
AUTH_SESSION_TTL_SECONDS=3600
# Staging/production must explicitly list their non-development origins. Wildcard,
# localhost, loopback and empty origin sets are rejected in shared environments.
CORS_ORIGINS=http://localhost:3000

# Platform endpoints fail closed without an externally generated Fernet key.
# Generate/manage through trusted ops; never commit a real key or enrollment file.
PLATFORM_ENCRYPTION_KEY=
PLATFORM_SESSION_TTL_SECONDS=3600
PLATFORM_STEP_UP_SECONDS=300
# Enable only with an approved secure one-time Director credential handoff.
PLATFORM_CREDENTIAL_HANDOFF_ENABLED=false
