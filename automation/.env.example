# Copy to .env, then set only deployment configuration here (never credentials).
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.41.7
CODEX_VERSION=0.161.0
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_OR_LONGER_KEY
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
START_ENABLED=false
CODEX_TIMEOUT_SECONDS=1800
